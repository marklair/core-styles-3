# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# macOS files
.DS_Store

# Text editor files
.idea

# Explicitly ignored files
*--ignore
**/*--ignore

# Node Modules
node_modules

# Version Files
versions
versions/*

# ignore machine-specific obsidian config  
 /notes-*/.obsidian/workspace.json
 
 # selectively ignore theme-related obsidian vault settings
 /notes-*/.obsidian/themes/AnuPpuccin/
 /notes-*/.obsidian/snippets/
 /notes-*/.obsidian/plugins/obsidian-style-settings/
 /notes-*/.obsidian/appearance.json
